{
  "version": 1,
  "id": "beginner-prompt-injection-containment",
  "title": "Contain prompt injection at the effect boundary",
  "purpose": "Show that probabilistic detection can miss while canonical provenance, strict schemas, and exact application authorization prevent influenced model output from becoming a side effect.",
  "output": {
    "svg": "architecture2.svg",
    "medium": "GitHub Markdown and Learning Hub",
    "alt_text": "Untrusted documents pass through canonical ingestion and a probabilistic detector to a model that may be influenced. The model proposes an action, but a trusted policy gateway resolves source evidence and validates the proposal against authenticated workflow context and an exact one-use grant before sending only allowed effects to an executor. Decisions and effects produce redacted receipts."
  },
  "canvas": {"width": 1600, "height": 900, "background": "#F7F9FC", "margin": 56, "grid": 8},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 40, "min_layer_gap": 56, "node_padding": {"x": 20, "y": 16}},
