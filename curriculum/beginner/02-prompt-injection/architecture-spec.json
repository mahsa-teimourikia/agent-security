    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "untrusted": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "signal": {"fill": "#FFF7E8", "stroke": "#E09B32"},
      "service": {"fill": "#EAF1FF", "stroke": "#2F6BFF"},
      "data": {"fill": "#E5F7F6", "stroke": "#16A3A5"},
      "action": {"fill": "#FFF1DF", "stroke": "#F59E42"},
      "operations": {"fill": "#FFFFFF", "stroke": "#AAB7C7"}
    }
  },
  "groups": [
