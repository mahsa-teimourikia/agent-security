    {"id": "control", "label": "Trusted application control plane", "bounds": {"x": 760, "y": 140, "width": 500, "height": 700}, "fill": "#FFFFFF", "stroke": "#C8D7F4"},
    {"id": "protected", "label": "Protected system", "bounds": {"x": 1304, "y": 140, "width": 240, "height": 540}, "fill": "#FFFBF5", "stroke": "#F3D3A8"}
  ],
