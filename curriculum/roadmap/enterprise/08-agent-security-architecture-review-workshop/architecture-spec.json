    {"id": "evidence", "group": "review", "type": "state", "label": "Evidence admission", "detail": "producer • tenant • subject • version • freshness", "x": 90, "y": 525, "w": 280, "h": 110, "padding": 16, "ports": {"out": "right"}},
    {"id": "rules", "group": "review", "type": "enforcement", "label": "Versioned invariants", "detail": "tenant • authority • effect • failure • owner", "x": 455, "y": 525, "w": 280, "h": 110, "padding": 16, "ports": {"in": "left", "graph": "top", "out": "right"}},
