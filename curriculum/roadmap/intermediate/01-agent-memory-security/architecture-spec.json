    {"from": "write_result", "to": "audit", "kind": "evidence", "label": "write receipt", "points": [[665, 525], [665, 600], [1145, 600], [1145, 685]], "label_at": [900, 590]},
    {"from": "read_policy", "to": "audit", "kind": "evidence", "label": "read receipt", "points": [[1530, 270], [1570, 270], [1570, 600], [1190, 600], [1190, 685]], "label_at": [1390, 590]},
    {"from": "audit", "to": "terminal", "kind": "evidence", "label": "observable", "points": [[1270, 737], [1335, 737]], "label_at": [1302, 727]}
