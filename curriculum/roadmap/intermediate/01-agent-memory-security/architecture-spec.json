{
  "id": "intermediate-01-agent-memory-security",
  "version": "1.0",
  "title": "Secure Long-Term Memory Lifecycle",
  "subtitle": "Model proposals cross trusted write and read gates; lifecycle state never becomes authority",
  "canvas": {"width": 1600, "height": 900, "background": "#F7F9FC"},
  "groups": [
    {"id": "proposal", "label": "UNTRUSTED PROPOSAL", "x": 45, "y": 130, "w": 270, "h": 450},
    {"id": "write", "label": "TRUSTED WRITE BOUNDARY", "x": 350, "y": 130, "w": 430, "h": 450},
    {"id": "store", "label": "SCOPED LIFECYCLE STORE", "x": 815, "y": 130, "w": 280, "h": 450},
    {"id": "read", "label": "TRUSTED READ BOUNDARY", "x": 1130, "y": 130, "w": 425, "h": 450},
    {"id": "lifecycle", "label": "LIFECYCLE + DECISION EVIDENCE", "x": 350, "y": 620, "w": 1205, "h": 230}
  ],
  "nodes": [
    {"id": "actor", "group": "proposal", "type": "control", "label": "Authenticated actor", "detail": "tenant • subject • purpose • deletion epoch", "x": 70, "y": 190, "w": 220, "h": 105},
