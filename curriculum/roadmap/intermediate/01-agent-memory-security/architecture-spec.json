    {"id": "source", "group": "write", "type": "control", "label": "Source + consent", "detail": "exact ref • scope • authority • freshness", "x": 375, "y": 190, "w": 180, "h": 115},
    {"id": "write_policy", "group": "write", "type": "enforcement", "label": "Admission policy", "detail": "type • schema • class • TTL", "x": 575, "y": 190, "w": 180, "h": 115},
    {"id": "replay", "group": "write", "type": "control", "label": "Replay + version gate", "detail": "proposal digest • compare-and-swap", "x": 375, "y": 410, "w": 180, "h": 115},
    {"id": "write_result", "group": "write", "type": "decision", "label": "Write decision", "detail": "create • update • deny • conflict • error", "x": 575, "y": 410, "w": 180, "h": 115},
    {"id": "memory", "group": "store", "type": "state", "label": "Versioned memory", "detail": "tenant/subject key • source • consent • TTL • lifecycle • epoch", "x": 840, "y": 255, "w": 230, "h": 165},
    {"id": "read_request", "group": "read", "type": "control", "label": "Authorized read", "detail": "scope + purpose before lookup", "x": 1155, "y": 190, "w": 175, "h": 115},
    {"id": "read_policy", "group": "read", "type": "enforcement", "label": "Lifecycle gate", "detail": "active • epoch • expiry • current consent", "x": 1350, "y": 190, "w": 180, "h": 115},
    {"id": "view", "group": "read", "type": "untrusted", "label": "Bounded memory view", "detail": "untrusted data • never tool authority", "x": 1250, "y": 410, "w": 220, "h": 115},
    {"id": "deletion", "group": "lifecycle", "type": "enforcement", "label": "Deletion + retention", "detail": "erase • tombstone • increment epoch • sweep", "x": 390, "y": 685, "w": 250, "h": 105},
    {"id": "registry", "group": "lifecycle", "type": "state", "label": "Current registries", "detail": "source • consent • policy versions", "x": 705, "y": 685, "w": 250, "h": 105},
    {"id": "audit", "group": "lifecycle", "type": "state", "label": "Minimized receipt", "detail": "IDs • digests • versions • reason; no raw value", "x": 1020, "y": 685, "w": 250, "h": 105},
    {"id": "terminal", "group": "lifecycle", "type": "decision", "label": "Explicit outcomes", "detail": "ready/empty • deny • conflict • error", "x": 1335, "y": 685, "w": 185, "h": 105}
  ],
  "edges": [
