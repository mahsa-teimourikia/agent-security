    {"id": "writer", "group": "consumer", "type": "untrusted", "label": "Writer agent", "detail": "receives minimized, admitted context", "x": 1030, "y": 205, "w": 290, "h": 105, "padding": 16, "ports": {"in": "left", "out": "bottom"}},
