    {"id": "effect", "group": "outcomes", "type": "enforcement", "label": "Narrow idempotent effect", "detail": "only the independently authorized operation", "x": 850, "y": 850, "w": 260, "h": 120, "padding": 16, "ports": {"in": "left", "audit": "bottom"}},
