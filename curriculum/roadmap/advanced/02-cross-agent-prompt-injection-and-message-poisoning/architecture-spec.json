    {"id": "message", "group": "producer", "type": "untrusted", "label": "Peer message proposal", "detail": "hostile prose + bounded summary; never a grant", "x": 80, "y": 435, "w": 280, "h": 120, "padding": 16, "ports": {"in": "top", "out": "right"}},
    {"id": "registry", "group": "control", "type": "state", "label": "Source registry", "detail": "tenant • version • digest • taint • allowed use", "x": 475, "y": 205, "w": 200, "h": 110, "padding": 16, "ports": {"out": "bottom"}},
