{
  "id": "advanced-02-cross-agent-message-boundary",
  "version": "1.0",
  "title": "Authenticated Peer Messages Remain Untrusted Data",
  "subtitle": "Identity attributes a message; provenance, taint, allowed use, and current authorization constrain what downstream agents may do",
  "canvas": {"width": 1400, "height": 1400, "background": "#F7F9FC"},
