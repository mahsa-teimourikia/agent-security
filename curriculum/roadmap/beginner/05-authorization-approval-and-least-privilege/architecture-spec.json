{
  "version": 1,
  "id": "authorization-approval-least-privilege",
  "title": "Authorize now, approve exactly, enforce atomically",
  "subtitle": "The model proposes. Trusted identity, current state, policy, and an independent approver govern one bounded effect.",
  "purpose": "Show an untrusted action proposal entering a PDP, independent exact approval, and a PEP that reauthorizes and atomically consumes the receipt before one effect.",
  "output": {
    "svg": "architecture.svg",
    "medium": "documentation-and-notebook",
    "alt_text": "An agent proposal and trusted identity and resource state feed a policy information point and policy decision point. A high-risk decision pauses for an independent approver and a server-owned receipt store. The policy enforcement point reauthorizes current state, validates and atomically consumes the receipt, creates one narrow effect, and records bounded evidence."
  },
  "canvas": {"width": 1600, "height": 900, "background": "#F7F9FC", "margin": 60, "grid": 10},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 32, "min_layer_gap": 50},
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "semantic_colors": {
      "untrusted": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "state": {"fill": "#FFFFFF", "stroke": "#52606D"},
      "decision": {"fill": "#EAF1FF", "stroke": "#2F6BFF"},
      "approval": {"fill": "#FFF1DF", "stroke": "#F59E42"},
      "enforcement": {"fill": "#E5F7F6", "stroke": "#16A3A5"}
    }
  },
  "groups": [
    {"id": "inputs", "label": "1. Propose and resolve", "bounds": {"x": 60, "y": 150, "width": 300, "height": 620}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "decision", "label": "2. Decide under current policy", "bounds": {"x": 410, "y": 150, "width": 420, "height": 620}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "approval", "label": "3. Review exact high-risk action", "bounds": {"x": 880, "y": 150, "width": 300, "height": 620}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "enforce", "label": "4. Reauthorize and commit once", "bounds": {"x": 1230, "y": 150, "width": 310, "height": 620}, "fill": "#FFFFFF", "stroke": "#D7DEE8"}
  ],
  "nodes": [
    {"id": "proposal", "group": "inputs", "label": "Agent action proposal", "subtitle": "operation · resource · arguments · operation ID", "type": "untrusted", "bounds": {"x": 100, "y": 240, "width": 220, "height": 120}, "ports": {"out": {"side": "right", "offset": 0.5}}},
    {"id": "trusted", "group": "inputs", "label": "Trusted application context", "subtitle": "subject · workload · tenant · session · case", "type": "state", "bounds": {"x": 100, "y": 530, "width": 220, "height": 120}, "ports": {"out": {"side": "right", "offset": 0.5}}},
    {"id": "pip", "group": "decision", "label": "PIP", "subtitle": "current identity, relationship, resource, risk", "type": "state", "bounds": {"x": 450, "y": 230, "width": 150, "height": 130}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "pap", "group": "decision", "label": "PAP", "subtitle": "reviewed versioned policy", "type": "state", "bounds": {"x": 450, "y": 550, "width": 150, "height": 100}, "ports": {"out": {"side": "right", "offset": 0.5}}},
    {"id": "pdp", "group": "decision", "label": "Policy decision point", "subtitle": "ALLOW · PAUSE · DENY · ERROR", "type": "decision", "bounds": {"x": 640, "y": 370, "width": 150, "height": 150}, "ports": {"proposal": {"side": "left", "offset": 0.25}, "pip": {"side": "left", "offset": 0.1}, "pap": {"side": "left", "offset": 0.85}, "pause": {"side": "right", "offset": 0.25}, "allow": {"side": "right", "offset": 0.55}, "reauth": {"side": "right", "offset": 0.9}}},
    {"id": "approver", "group": "approval", "label": "Independent approver", "subtitle": "eligible · same tenant · not requester", "type": "approval", "bounds": {"x": 920, "y": 240, "width": 220, "height": 130}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "bottom", "offset": 0.5}}},
    {"id": "store", "group": "approval", "label": "Server-owned receipt store", "subtitle": "exact binding · expiry · revocation · single use", "type": "approval", "bounds": {"x": 920, "y": 510, "width": 220, "height": 130}, "ports": {"in": {"side": "top", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "pep", "group": "enforce", "label": "Policy enforcement point", "subtitle": "current decision + exact receipt + atomic consume", "type": "enforcement", "bounds": {"x": 1270, "y": 270, "width": 230, "height": 160}, "ports": {"decision": {"side": "left", "offset": 0.25}, "approval": {"side": "left", "offset": 0.75}, "reauth": {"side": "left", "offset": 0.95}, "effect": {"side": "bottom", "offset": 0.3}, "evidence": {"side": "bottom", "offset": 0.78}}},
    {"id": "effect", "group": "enforce", "label": "One refund effect", "subtitle": "stable operation ID", "type": "state", "bounds": {"x": 1255, "y": 560, "width": 125, "height": 100}, "ports": {"in": {"side": "top", "offset": 0.5}}},
    {"id": "trace", "group": "enforce", "label": "Bounded evidence", "subtitle": "decision · receipt · outcome", "type": "enforcement", "bounds": {"x": 1400, "y": 560, "width": 125, "height": 100}, "ports": {"in": {"side": "top", "offset": 0.5}}}
  ],
  "edges": [
