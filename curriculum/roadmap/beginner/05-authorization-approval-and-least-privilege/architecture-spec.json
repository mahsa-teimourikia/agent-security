    {"id": "trusted_pip", "from": {"node": "trusted", "port": "out"}, "to": {"node": "pip", "port": "in"}, "label": "resolve current state", "kind": "secondary", "route": [[320, 590], [390, 590], [390, 295], [450, 295]], "label_at": [390, 470]},
    {"id": "pip_pdp", "from": {"node": "pip", "port": "out"}, "to": {"node": "pdp", "port": "pip"}, "label": "trusted attributes", "kind": "secondary", "route": [[600, 295], [620, 295], [620, 385], [640, 385]], "label_at": [650, 325]},
    {"id": "pap_pdp", "from": {"node": "pap", "port": "out"}, "to": {"node": "pdp", "port": "pap"}, "label": "policy version", "kind": "secondary", "route": [[600, 600], [620, 600], [620, 497.5], [640, 497.5]], "label_at": [680, 585]},
    {"id": "pdp_approver", "from": {"node": "pdp", "port": "pause"}, "to": {"node": "approver", "port": "in"}, "label": "PAUSE · exact binding", "kind": "approval", "route": [[790, 407.5], [850, 407.5], [850, 305], [920, 305]], "label_at": [850, 292]},
    {"id": "approver_store", "from": {"node": "approver", "port": "out"}, "to": {"node": "store", "port": "in"}, "label": "issue or reject", "kind": "approval", "route": [[1030, 370], [1030, 510]], "label_at": [1090, 420]},
    {"id": "pdp_pep", "from": {"node": "pdp", "port": "allow"}, "to": {"node": "pep", "port": "decision"}, "label": "current decision", "kind": "primary", "route": [[790, 452.5], [1200, 452.5], [1200, 310], [1270, 310]], "label_at": [1090, 480]},
    {"id": "store_pep", "from": {"node": "store", "port": "out"}, "to": {"node": "pep", "port": "approval"}, "label": "stored receipt state", "kind": "approval", "route": [[1140, 575], [1210, 575], [1210, 390], [1270, 390]], "label_at": [1215, 550]},
    {"id": "pep_pdp", "from": {"node": "pep", "port": "reauth"}, "to": {"node": "pdp", "port": "reauth"}, "label": "reauthorize before effect", "kind": "feedback", "route": [[1270, 422], [1220, 422], [1220, 720], [815, 720], [815, 505], [790, 505]], "label_at": [1010, 705]},
    {"id": "pep_effect", "from": {"node": "pep", "port": "effect"}, "to": {"node": "effect", "port": "in"}, "label": "commit once", "kind": "primary", "route": [[1339, 430], [1339, 510], [1317.5, 510], [1317.5, 560]], "label_at": [1295, 500]},
    {"id": "pep_trace", "from": {"node": "pep", "port": "evidence"}, "to": {"node": "trace", "port": "in"}, "label": "record outcome", "kind": "primary", "route": [[1449.4, 430], [1449.4, 510], [1462.5, 510], [1462.5, 560]], "label_at": [1490, 500]}
  ],
  "validation": {"no_overlaps": true, "route_around_nodes": true, "min_text_padding": 16, "verify_port_attachment": true, "verify_contrast": true}
}
