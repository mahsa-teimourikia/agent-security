{
  "version": 1,
  "id": "security-invariants-blast-radius",
  "title": "Security invariants: proposal to bounded effect",
  "purpose": "Show how trusted state and trajectory-wide invariants constrain an untrusted agent proposal and produce attributable evidence.",
  "output": {
    "svg": "architecture.svg",
    "medium": "documentation-and-notebook",
    "alt_text": "Security objectives define invariants and a multidimensional blast-radius ceiling. An untrusted model proposal enters a trusted application gate alongside authenticated identity, a bounded capability, current policy, budgets, and a kill switch. Only a valid transition reaches the effect ledger; decisions and effects feed evidence and safety-plus-utility evaluation."
  },
  "canvas": {"width": 1600, "height": 900, "background": "#F7F9FC", "margin": 60, "grid": 10},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 40, "min_layer_gap": 60},
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "semantic_colors": {
      "objective": {"fill": "#EAF1FF", "stroke": "#2F6BFF"},
      "untrusted": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "control": {"fill": "#FFF1DF", "stroke": "#F59E42"},
      "evidence": {"fill": "#E5F7F6", "stroke": "#16A3A5"},
      "operations": {"fill": "#FFFFFF", "stroke": "#52606D"}
    }
  },
  "groups": [
    {"id": "define", "label": "1. Define what must always hold", "bounds": {"x": 60, "y": 150, "width": 300, "height": 600}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "enforce", "label": "2. Enforce every consequential transition", "bounds": {"x": 410, "y": 150, "width": 760, "height": 600}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "verify", "label": "3. Verify trajectories and utility", "bounds": {"x": 1220, "y": 150, "width": 320, "height": 600}, "fill": "#FFFFFF", "stroke": "#D7DEE8"}
  ],
  "nodes": [
    {"id": "objectives", "group": "define", "label": "Security objectives", "subtitle": "assets · harms · tolerances", "type": "objective", "bounds": {"x": 100, "y": 240, "width": 220, "height": 110}, "ports": {"out": {"side": "right", "offset": 0.5}}},
    {"id": "ceiling", "group": "define", "label": "Blast-radius ceiling", "subtitle": "tenants · resources · value · writes · egress · time", "type": "objective", "bounds": {"x": 100, "y": 510, "width": 220, "height": 140}, "ports": {"in": {"side": "right", "offset": 0.5}}},
    {"id": "proposal", "group": "enforce", "label": "Model proposal", "subtitle": "untrusted operation and arguments", "type": "untrusted", "bounds": {"x": 450, "y": 230, "width": 200, "height": 110}, "ports": {"out": {"side": "right", "offset": 0.5}}},
    {"id": "identity", "group": "enforce", "label": "Authenticated context", "subtitle": "subject · tenant · scope", "type": "operations", "bounds": {"x": 450, "y": 470, "width": 200, "height": 110}, "ports": {"out": {"side": "right", "offset": 0.5}}},
    {"id": "capability", "group": "enforce", "label": "Bounded capability", "subtitle": "resources · limits · expiry", "type": "operations", "bounds": {"x": 720, "y": 230, "width": 210, "height": 110}, "ports": {"out": {"side": "bottom", "offset": 0.5}}},
    {"id": "gate", "group": "enforce", "label": "Invariant gate", "subtitle": "state · transition · temporal checks", "type": "control", "bounds": {"x": 700, "y": 430, "width": 250, "height": 140}, "ports": {"objective": {"side": "left", "offset": 0.5}, "proposal": {"side": "left", "offset": 0.3}, "identity": {"side": "left", "offset": 0.7}, "capability": {"side": "top", "offset": 0.5}, "effect": {"side": "right", "offset": 0.5}, "kill": {"side": "right", "offset": 0.75}, "ceiling": {"side": "bottom", "offset": 0.3}, "evidence": {"side": "bottom", "offset": 0.7}}},
    {"id": "effect", "group": "enforce", "label": "Effect ledger", "subtitle": "idempotent receipt", "type": "evidence", "bounds": {"x": 990, "y": 230, "width": 140, "height": 110}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "kill", "group": "enforce", "label": "Kill switch", "subtitle": "current effect state", "type": "operations", "bounds": {"x": 990, "y": 520, "width": 140, "height": 110}, "ports": {"out": {"side": "left", "offset": 0.5}}},
    {"id": "evidence", "group": "verify", "label": "Attributable evidence", "subtitle": "decision · reason · versions · digests", "type": "evidence", "bounds": {"x": 1260, "y": 240, "width": 240, "height": 140}, "ports": {"effect": {"side": "left", "offset": 0.35}, "out": {"side": "bottom", "offset": 0.5}}},
    {"id": "evaluation", "group": "verify", "label": "Safety + utility evaluation", "subtitle": "attack effects · valid success · drift", "type": "evidence", "bounds": {"x": 1260, "y": 510, "width": 240, "height": 140}, "ports": {"decision": {"side": "left", "offset": 0.5}, "evidence": {"side": "top", "offset": 0.5}}}
  ],
  "edges": [
