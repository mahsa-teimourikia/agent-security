    {"id": "identity_to_gate", "from": {"node": "identity", "port": "out"}, "to": {"node": "gate", "port": "identity"}, "label": "trusted context", "kind": "secondary", "route": [[650, 525], [675, 525], [675, 528], [700, 528]], "label_at": [670, 605]},
    {"id": "capability_to_gate", "from": {"node": "capability", "port": "out"}, "to": {"node": "gate", "port": "capability"}, "label": "maximum authority", "kind": "secondary", "route": [[825, 340], [825, 430]], "label_at": [895, 390]},
    {"id": "kill_to_gate", "from": {"node": "kill", "port": "out"}, "to": {"node": "gate", "port": "kill"}, "label": "recheck", "kind": "feedback", "route": [[990, 575], [970, 575], [970, 535], [950, 535]], "label_at": [1000, 510]},
    {"id": "gate_to_effect", "from": {"node": "gate", "port": "effect"}, "to": {"node": "effect", "port": "in"}, "label": "valid transition", "kind": "primary", "route": [[950, 500], [970, 500], [970, 285], [990, 285]], "label_at": [1015, 470]},
    {"id": "effect_to_evidence", "from": {"node": "effect", "port": "out"}, "to": {"node": "evidence", "port": "effect"}, "label": "effect receipt", "kind": "primary", "route": [[1130, 285], [1185, 285], [1185, 289], [1260, 289]], "label_at": [1195, 270]},
    {"id": "gate_to_evaluation", "from": {"node": "gate", "port": "evidence"}, "to": {"node": "evaluation", "port": "decision"}, "label": "all decisions", "kind": "secondary", "route": [[875, 570], [875, 690], [1190, 690], [1190, 580], [1260, 580]], "label_at": [1050, 710]},
    {"id": "evidence_to_evaluation", "from": {"node": "evidence", "port": "out"}, "to": {"node": "evaluation", "port": "evidence"}, "label": "trajectory", "kind": "primary", "route": [[1380, 380], [1380, 510]], "label_at": [1425, 450]},
    {"id": "gate_to_ceiling", "from": {"node": "gate", "port": "ceiling"}, "to": {"node": "ceiling", "port": "in"}, "label": "enforced ceiling", "kind": "feedback", "route": [[775, 570], [775, 680], [380, 680], [380, 580], [320, 580]], "label_at": [560, 700]}
  ],
  "validation": {"no_overlaps": true, "route_around_nodes": true, "min_text_padding": 16, "verify_port_attachment": true, "verify_contrast": true}
}
